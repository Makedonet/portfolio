---
import ServiceScene from "./ServiceScene.astro";
import { services } from "../data/services";
import { typo } from "../lib/typo";
---

<section aria-labelledby="services-title" id="services" class="scroll-mt-16 overflow-x-clip bg-surface">
  {/* На широком экране секция закрепляется: слева список услуг, по нему идёт
      маркер, справа снизу наезжают цветные листы со сценами (scripts/services.ts).
      На телефоне, без скрипта и при «уменьшить движение» — та же разметка лентой
      карточек, которую листают вбок. */}
  <div class="services-pin" data-services>
    <div class="services-head">
      <h2 id="services-title" class="services-title font-display font-bold text-balance" data-split set:html={typo("«Под ключ» - это всё, что нужно сайту")} />
      <p
        class="services-intro leading-relaxed text-ink-2"
        data-fade
        set:html={typo("Не нужно искать отдельно дизайнера, верстальщика и специалиста, который «подключит формы». Один человек ведёт ваш сайт от первого звонка до запуска и после него.")}
      />
    </div>

    {/* Лента листается и с клавиатуры, поэтому в порядке Tab. */}
    <ol class="services-track" tabindex="0" aria-label="Что входит в работу под ключ">
      {
        services.map((service, i) => (
          <li class={`service tone-${service.tone}`} data-service>
            <h3 class="service-name font-display font-bold" style={`--row:${i + 3}`}>
              <span data-service-name>{service.title}</span>
            </h3>
            <div class="service-sheet" data-service-sheet>
              <div class="service-stage">
                <ServiceScene scene={service.scene} />
              </div>
              <p class="service-text leading-relaxed" set:html={typo(service.text)} />
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  {/* Буханка «Корки» из роликов «Как работаю», общая для сцен. */}
  <svg class="hidden" aria-hidden="true">
    <symbol id="sc-loaf" viewBox="-2 -2 204 204">
      <circle cx="100" cy="100" r="100" fill="#e8983a" />
      <circle cx="100" cy="100" r="82" fill="#f0aa52" />
      <g fill="none" stroke="#ffe7c2" stroke-width="15" stroke-linecap="round">
        <path d="M50 62Q78 100 50 138" />
        <path d="M94 42Q122 100 94 158" />
        <path d="M138 62Q166 100 138 138" />
      </g>
    </symbol>
  </svg>
</section>
