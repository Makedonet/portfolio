---
import SectionHead from "./SectionHead.astro";
import { services } from "../data/services";
import { typo } from "../lib/typo";
---

<section aria-labelledby="services-title" id="services" class="scroll-mt-16 bg-surface py-20 sm:py-28">
  <div class="container-page">
    <SectionHead
      id="services-title"
      index="02"
      eyebrow="Что входит"
      title="«Под ключ» — это всё, что нужно сайту"
      intro="Не придётся искать отдельно дизайнера, верстальщика и того, кто «подключит формы». Один человек ведёт сайт от первого звонка до запуска и дальше."
    />

    <ul class="mt-12 grid border-t border-l border-line sm:mt-16 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <li
            class="flex flex-col gap-3 border-r border-b border-line p-6 sm:p-8"
            data-reveal
            style={`--reveal-delay: ${(i % 3) * 70}ms`}
          >
            <span class="font-mono text-sm text-muted">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="text-xl font-semibold tracking-[-0.015em]">{service.title}</h3>
            <p class="leading-relaxed text-ink-2" set:html={typo(service.text)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
