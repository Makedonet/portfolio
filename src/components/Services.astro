---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { services } from "../data/services";
import { typo } from "../lib/typo";
---

<section aria-labelledby="services-title" id="services" class="scroll-mt-16 bg-surface py-20 sm:py-28">
  <div class="container-page">
    <SectionHead
      id="services-title"
      title="«Под ключ» — это всё, что нужно сайту"
      intro="Не придётся искать отдельно дизайнера, верстальщика и того, кто «подключит формы». Один человек ведёт сайт от первого звонка до запуска и дальше."
    />

    {/* Ячейка при наведении заливается жёлтым снизу (global.css, .service). */}
    <ul class="mt-12 grid border-t border-l border-line sm:mt-16 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {
        services.map((service) => (
          <li class="service flex flex-col gap-3 border-r border-b border-line p-6 sm:p-8">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-xl font-semibold tracking-[-0.015em]">{service.title}</h3>
              <Icon name="arrow-up-right" class="service-arrow mt-1 size-5" />
            </div>
            <p class="leading-relaxed text-ink-2" set:html={typo(service.text)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
