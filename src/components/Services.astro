---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { services } from "../data/services";
import { typo } from "../lib/typo";
---

<section aria-labelledby="services-title" id="services" class="scroll-mt-16 overflow-x-clip bg-surface">
  {/* На широком экране секция закрепляется, а карточки едут вбок, пока
      страница листается вниз; полоса снизу — сколько проехали (motion.ts).
      На телефоне, без скрипта и при «уменьшить движение» — обычная сетка.
      Ячейка при наведении заливается жёлтым снизу (global.css, .service). */}
  <div class="services-pin bg-surface py-20 sm:py-28" data-services>
    <div class="container-page">
      <SectionHead
        id="services-title"
        title="«Под ключ» — это всё, что нужно сайту"
        intro="Не нужно искать отдельно дизайнера, верстальщика и специалиста, который «подключит формы». Один человек ведёт ваш сайт от первого звонка до запуска и после него."
      />
    </div>

    <ul class="services-track mt-12 sm:mt-16" data-services-track data-stagger>
      {
        services.map((service, i) => (
          <li class="service flex flex-col rounded-2xl border border-line bg-paper p-6 sm:p-7">
            <div class="flex items-start justify-between gap-4">
              <span class="font-mono text-sm text-muted" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <Icon name="arrow-up-right" class="service-arrow size-5" />
            </div>
            <h3 class="mt-10 text-[1.375rem] leading-tight font-semibold tracking-[-0.02em] sm:mt-14">{service.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-2" set:html={typo(service.text)} />
          </li>
        ))
      }
    </ul>

    <div class="services-progress container-page mt-10" aria-hidden="true">
      <span class="block h-[2px] origin-left scale-x-0 bg-ink" data-services-progress></span>
    </div>
  </div>
</section>
