---
// Мобильная версия того же сайта в корпусе телефона.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes, eager = false, class: className } = Astro.props;
---

<div
  class:list={[
    "overflow-hidden rounded-[1.4rem] border-[5px] border-ink bg-ink shadow-[0_18px_40px_-12px_rgb(17_17_16/0.45)] sm:rounded-[1.75rem] sm:border-[6px]",
    className,
  ]}
>
  <Picture
    src={src}
    alt={alt}
    widths={[180, 270, 360, 540, 720].filter((w) => w <= src.width)}
    sizes={sizes}
    formats={["avif"]}
    fallbackFormat="webp"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="block aspect-[390/844] h-auto w-full rounded-[1rem] object-cover object-top sm:rounded-[1.3rem]"
  />
</div>
