---
// Значение метрики. Первое целое число при появлении прокручивается до
// своего значения, как барабаны счётчика (data-count, motion.ts). Для
// скринридера — значение целиком.
interface Props {
  value: string;
}
const { value } = Astro.props;

/** Первое целое число и то, что вокруг него. Ноль, диапазоны («90–91») и
 *  дроби («6,7») не крутим: на полпути выходило бы «45–91» или «3,7». */
const match = value.match(/^(\D*?)(\d+)(.*)$/);
const parts = match && match[2] !== "0" && !/^[–,.-]\d/.test(match[3]!) ? { head: match[1], number: match[2], tail: match[3] } : null;
---

{
  parts ? (
    <>
      <span aria-hidden="true">
        {parts.head}
        <span data-count={parts.number}>{parts.number}</span>
        {parts.tail}
      </span>
      <span class="sr-only">{value}</span>
    </>
  ) : (
    value
  )
}
