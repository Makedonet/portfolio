interface Props {
  /** Название из `stack` в works.ts, можно с номером версии. */
  name: string;
  class?: string;
}

const { name, class: className = "size-3.5" } = Astro.props;
const logo = logos[name.replace(/ \d+$/, "")];
// Новая технология в кейсе без знака — ошибка сборки, а не пустое место в чипе.
if (!logo) throw new Error(`TechIcon: нет логотипа для «${name}»`);
---

<svg viewBox={logo.viewBox} class:list={["shrink-0", className]} aria-hidden="true" focusable="false" set:html={logo.body} />
