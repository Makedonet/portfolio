---
// Логотипы технологий из списка «На чём сделан» (WorkCase.astro) — в фирменных
// цветах, встроенным SVG. Ищутся по названию без номера версии: «Astro 7» —
// это Astro. Пути — Simple Icons 16.36 (CC0); кроме того, чего там нет:
// Remotion — из их фирменного пакета (remotion-dev/remotion, packages/brand),
// Яндекс Карты и Яндекс Облако — значки с их собственных сайтов. Вектора знака
// 2ГИС в открытом доступе нет, поэтому он картинкой — значок с 2gis.ru
// (assets/tech/2gis.png). Своего знака у Canvas API нет, это часть HTML5 —
// поэтому у него знак HTML5.
// Ракета Astro — цвета текста: при наведении чип темнеет, и она светлеет
// вместе с подписью. Буквы, что в знаке вырезаны (TS, CSS, JS, PHP, самолётик
// Telegram), подложены своим цветом, чтобы не темнели вместе с чипом.
import twoGis from "../assets/tech/2gis.png";

type Logo = { viewBox: string; body: string };

const html5: Logo = {
  viewBox: "0 0 24 24",
  body: '<path fill="#E34F26" d="M1.5 0h21l-1.91 21.563L11.977 24l-8.564-2.438L1.5 0zm7.031 9.75l-.232-2.718 10.059.003.23-2.622L5.412 4.41l.698 8.01h9.126l-.326 3.426-2.91.804-2.955-.81-.188-2.11H6.248l.33 4.171L12 19.351l5.379-1.443.744-8.157H8.531z"/>',
