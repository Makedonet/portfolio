---
// Главный кейс на главной: окно сайта с телефоном, отрасль, пара фраз о сайте и
// результат для бизнеса тёмной карточкой. Целиком кейс — на своей странице
// (pages/works/[id].astro), туда ведут и кнопка, и клик по окну.
// Окно помечено data-vt: при переходе на страницу кейса оно перетекает в окно
// там (Layout.astro, View Transitions).
import LiveWindow from "./LiveWindow.astro";
import Icon from "./Icon.astro";
import MetricValue from "./MetricValue.astro";
import { caseUrl, keyFigures, type Work } from "../data/works";
import { typo } from "../lib/typo";

interface Props {
  work: Work;
}

const { work } = Astro.props;
const headingId = `work-${work.id}`;
const href = caseUrl(work.id);
const figures = keyFigures(work);
const phone = work.screens.mobile;
---

<article id={`case-${work.id}`} aria-labelledby={headingId} class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-14" data-case>
  <div class="relative lg:col-span-7" data-live-group data-tilt="5">
    <div class:list={["relative", phone && "pr-[9%] pb-8 sm:pb-10"]} data-tilt-target>
      <div data-case-visual data-vt={work.id}>
        <LiveWindow
          scenes={work.screens.desktop}
          device="desktop"
          sizes="(min-width: 1280px) 40rem, (min-width: 1024px) 52vw, 92vw"
          label={`Сайт ${work.urlLabel} листается сам${work.screens.desktop.length > 1 ? ", по нескольким страницам" : ""}`}
          href={href}
          toggle={work.urlLabel}
          delay={0.3}
        />
      </div>
      {
        phone && (
          <div class="absolute right-0 bottom-0 w-[24%]" data-depth="18">
            <div data-case-phone>
              <LiveWindow
                scenes={[phone]}
                device="mobile"
                sizes="(min-width: 1024px) 10rem, 24vw"
                label={`Мобильная версия ${work.urlLabel} листается сама`}
                href={href}
                delay={1.3}
              />
            </div>
          </div>
        )
      }
    </div>
  </div>

  <div class="lg:col-span-5">
    <div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2" data-fade>
        <span class="text-sm text-muted">{work.industry}</span>
        <span
          class:list={[
            "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium",
            work.status.tone === "live" ? "border-ok/30 bg-ok/10 text-ok-text" : "border-line bg-surface text-muted",
          ]}
        >
          {work.status.tone === "live" && <span class="size-1.5 animate-pulse rounded-full bg-ok motion-reduce:animate-none" aria-hidden="true" />}
          {work.status.label}
        </span>
      </div>
      <h3 id={headingId} class="mt-3 font-display text-[2.75rem] leading-[1.02] font-bold text-balance sm:text-[4rem]" data-split set:html={typo(work.title)} />
      <p class="mt-3 leading-relaxed text-ink-2 sm:text-lg" data-fade set:html={typo(work.summary)} />
    </div>

    <dl class="case-result on-dark grid grid-cols-2 gap-x-6 gap-y-4" data-fade>
      {
        figures.map((figure) => (
          <div class="flex flex-col gap-1.5">
            <dt class="order-2 text-sm leading-snug text-muted-dark" set:html={typo(figure.label)} />
            <dd class="order-1 font-display text-[clamp(2.25rem,11vw,3rem)] leading-none font-bold whitespace-nowrap text-accent sm:text-[3.75rem]">
              <MetricValue value={figure.value} />
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3" data-fade>
      <a href={href} class="btn btn-primary">
        Читать кейс
        <span class="sr-only">: {work.title}</span>
        <Icon name="arrow-right" class="size-4" />
      </a>
      <a href={work.url} target="_blank" rel="noopener noreferrer" class="group inline-flex min-h-11 items-center gap-2 text-muted hover:text-ink">
        <span class="link-line text-[0.9375rem]">{work.urlLabel}</span>
        <Icon name="arrow-up-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" />
        <span class="sr-only">(откроется в новой вкладке)</span>
      </a>
    </div>
  </div>
</article>
