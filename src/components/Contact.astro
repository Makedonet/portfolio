---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { contact, phone } from "../data/site";
import { typo } from "../lib/typo";
import maxIcon from "../assets/icons/max.png";

const brief = [
  "чем занимается ваш бизнес и кто ваши клиенты",
  "что сайт должен делать: продавать, собирать заявки, рассказывать о компании",
  "есть ли сайт сейчас и какие сайты вам нравятся",
  "к какому сроку нужен запуск",
];

const telegram = contact("telegram");
const whatsapp = contact("whatsapp");
const max = contact("max");
---

<section aria-labelledby="contact-title" id="contact" class="on-dark relative isolate scroll-mt-16 overflow-clip bg-ink text-paper">
  {/* Пятно света за курсором (motion.ts, global.css .contact-glow). */}
  <div class="contact-glow" aria-hidden="true" data-contact-glow></div>
  <div class="container-page grid gap-14 py-20 sm:py-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <h2 id="contact-title" class="font-display text-[3.25rem] leading-none font-bold text-balance sm:text-[5.5rem]" data-split>
        Обсудим ваш сайт
      </h2>
      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-muted-dark"
        data-fade
        set:html={typo(
          "Позвоните или напишите в мессенджер - отвечу, задам несколько уточняющих вопросов и предложу, с чего начать. Чтобы разговор сразу был предметным, заранее подумайте:",
        )}
      />
      <ul class="mt-6 max-w-xl space-y-3" data-stagger>
        {
          brief.map((item) => (
            <li class="flex gap-3 leading-snug">
              <span class="mt-0.5" data-draw>
                <Icon name="check" class="size-[1.125rem] text-accent" />
              </span>
              <span set:html={typo(item)} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-5 lg:pt-14" data-fade>
      <div class="rounded-2xl border border-line-dark bg-ink-2 p-6 sm:p-8">
        <p class="text-sm text-muted-dark">Телефон и WhatsApp</p>
        {/* На самых узких экранах кнопка уходит под номер, а не распирает блок. */}
        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2">
          <a
            href={phone.href}
            class="group inline-block font-display text-[2.75rem] leading-tight font-bold whitespace-nowrap text-paper sm:text-[3.25rem] lg:text-5xl xl:text-[3.25rem]"
          >
            <span class="link-line link-line-dark phone-number">{phone.display}</span>
          </a>
          {/* На компьютере tel: никуда не звонит — номер удобнее скопировать. */}
          <button
            type="button"
            class="copy-btn size-11 shrink-0 place-items-center rounded-full border border-line-dark text-muted-dark transition-colors duration-300 hover:border-paper hover:text-paper"
            aria-label="Скопировать номер"
            title="Скопировать номер"
            data-copy={phone.e164}
          >
            <svg viewBox="0 0 24 24" class="copy-idle size-[1.125rem]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="12" height="12" rx="2.5"></rect>
              <path d="M5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V5"></path>
            </svg>
            <svg viewBox="0 0 24 24" class="copy-done size-[1.125rem] text-accent" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </button>
          <p class="sr-only" role="status" data-copy-status></p>
        </div>
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          <a href={telegram.href} target="_blank" rel="noopener noreferrer" class="btn btn-accent w-full" title={telegram.title}>
            <Icon name="telegram" class="size-5" />
            {telegram.handle}
            <span class="sr-only">- Telegram (откроется в новой вкладке)</span>
          </a>
          <a href={max.href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost-dark w-full" title={max.title}>
            <Image src={maxIcon} alt="" width={20} height={20} class="size-5 rounded-[5px]" />
            MAX
            <span class="sr-only">(откроется в новой вкладке)</span>
          </a>
          <a href={whatsapp.href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost-dark w-full" title={whatsapp.title}>
            <Icon name="whatsapp" class="size-5" />
            WhatsApp
            <span class="sr-only">(откроется в новой вкладке)</span>
          </a>
          <a href={phone.href} class="btn btn-ghost-dark w-full">
            <Icon name="phone" class="size-4" />
            Позвонить
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
