---
// Обложка страницы кейса: название, отрасль и ссылка на сайт — на сцене из
// мира заказчика, в цветах его сайта. MC-PROJECT — разрез грунта, куда
// уходят инъекторы; шиномонтаж — колесо с красным диском, как на их
// логотипе; мойка — пена; ТИ — чертёж трещины в бетоне, которую заполняет
// смола. У каждой сцены одно движение: смола и пена — при открытии страницы,
// колесо докручивается при открытии и крутится при прокрутке, как на
// балансировочном станке. Без сцены (новый кейс) обложка просто тёмная.
// Нижняя полоса обложки — под окно сайта: WorkCase.astro поднимает окно
// сюда, и оно стоит на краю обложки.
import Icon from "./Icon.astro";
import type { Work } from "../data/works";
import { typo } from "../lib/typo";

interface Props {
  work: Work;
  index: number;
  total: number;
}

const { work, index, total } = Astro.props;
const num = (i: number) => String(i + 1).padStart(2, "0");

// Случайность с зерном: пузыри и трещина одинаковые от сборки к сборке.
const random = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const round = (n: number) => Math.round(n * 10) / 10;

// Сцены нарисованы в полосе 1440 × 160 — такой она на широком экране. На
// узком полоса обрезается слева: правый край сцены виден всегда.

// Мойка: пена гуще справа и у дна, вверх поднимаются редкие пузыри. Блик —
// дуга в левом верхнем углу пузыря. Пена встаёт волной справа налево.
const foam = (() => {
  const rnd = random(7);
  return Array.from({ length: 130 }, () => {
    const x = 1440 - rnd() ** 1.4 * 1440;
    const lift = rnd() ** 2.6;
    const y = 168 - lift * 150;
    const r = (1 - lift * 0.55) * (4 + rnd() * 19);
    const arc = (deg: number) => [x + r * 0.68 * Math.cos((deg * Math.PI) / 180), y + r * 0.68 * Math.sin((deg * Math.PI) / 180)].map(round).join(" ");
    return {
      x: round(x),
      y: round(y),
      r: round(r),
      shine: `M${arc(195)} A${round(r * 0.68)} ${round(r * 0.68)} 0 0 1 ${arc(250)}`,
      delay: round(0.2 + ((1440 - x) / 1440) * 0.7 + rnd() * 0.3),
    };
  }).sort((a, b) => b.r - a.r);
})();

// ТИ: трещина идёт через всю стену, смола заходит справа и течёт влево.
// Пакеры — через 120 по обе стороны трещины; каждый загорается, когда до
// него доходит смола.
const resinTime = 2.8;
const crack = (() => {
  const rnd = random(11);
  const points: Array<[number, number]> = [];
  for (let x = 1460; x >= -20; x -= 26 + rnd() * 26) {
    points.push([x, 104 - (x / 1440) * 16 + Math.sin(x / 190) * 11 + (rnd() - 0.5) * 14]);
  }
  return points;
})();
const crackPath = "M" + crack.map(([x, y]) => `${round(x)} ${round(y)}`).join(" L");
const crackAt = (x: number) => {
  const i = crack.findIndex(([px]) => px <= x);
  const [x1, y1] = crack[i - 1]!;
  const [x2, y2] = crack[i]!;
  return y1 + ((y2 - y1) * (x1 - x)) / (x1 - x2);
};
const packers = Array.from({ length: 12 }, (_, i) => {
  const x = 60 + i * 120;
  const onCrack = crackAt(x);
  return { x, y: round(onCrack + (i % 2 ? -27 : 27)), onCrack: round(onCrack), delay: round(0.4 + ((1460 - x) / 1480) * resinTime) };
});
const labelled = packers.at(-1)!;

// Колесо: протектор, боковина с надписью, красный диск со спицами.
const spokes = [0, 72, 144, 216, 288];
---

<section id="top" aria-label="О проекте" class:list={["cover on-dark", `cover-${work.id}`]}>
  <div class="cover-art" aria-hidden="true">
    {
      work.id === "mc-project" && (
        <svg class="art-band art-mc" viewBox="0 0 1440 160" preserveAspectRatio="xMaxYMax slice">
          <defs>
            <pattern id="mc-grain" width="18" height="16" patternUnits="userSpaceOnUse">
              <circle cx="4" cy="5" r="1.1" fill="#9fd8f5" fill-opacity="0.18" />
              <circle cx="13" cy="12" r="0.8" fill="#9fd8f5" fill-opacity="0.12" />
            </pattern>
            <radialGradient id="mc-resin">
              <stop offset="0" stop-color="#f6a45a" />
              <stop offset="0.45" stop-color="#e37a1d" stop-opacity="0.75" />
              <stop offset="1" stop-color="#e37a1d" stop-opacity="0" />
            </radialGradient>
            <clipPath id="mc-ground">
              <path d="M0 24 C 240 16 470 32 720 24 S 1180 16 1440 26 V160 H0Z" />
            </clipPath>
          </defs>
          <path d="M0 24 C 240 16 470 32 720 24 S 1180 16 1440 26 V160 H0Z" fill="#00314f" fill-opacity="0.45" />
          <path d="M0 60 C 280 52 540 68 800 58 S 1220 52 1440 62 V160 H0Z" fill="#002a45" fill-opacity="0.35" />
          <path d="M0 98 C 300 108 600 90 880 100 S 1260 108 1440 94 V160 H0Z" fill="#00243c" fill-opacity="0.35" />
          <path d="M0 136 C 260 128 620 144 920 134 S 1270 128 1440 138 V160 H0Z" fill="#001e33" fill-opacity="0.4" />
          <rect width="1440" height="160" fill="url(#mc-grain)" clip-path="url(#mc-ground)" />
          <g fill="none" stroke="#009fe3" stroke-width="1.5">
            <path d="M0 24 C 240 16 470 32 720 24 S 1180 16 1440 26" stroke-opacity="0.6" />
            <path d="M0 60 C 280 52 540 68 800 58 S 1220 52 1440 62" stroke-opacity="0.3" />
            <path d="M0 98 C 300 108 600 90 880 100 S 1260 108 1440 94" stroke-opacity="0.3" />
            <path d="M0 136 C 260 128 620 144 920 134 S 1270 128 1440 138" stroke-opacity="0.3" />
          </g>
          {[
            { x: 1010, tip: 84 },
            { x: 1150, tip: 112 },
            { x: 1290, tip: 70 },
          ].map(({ x, tip }, i) => (
            <g style={`--i: ${i}`}>
              <g class="mc-bulb">
                <ellipse cx={x} cy={tip} rx="56" ry="32" fill="url(#mc-resin)" />
                <ellipse cx={x} cy={tip} rx="76" ry="44" fill="none" stroke="#e37a1d" stroke-opacity="0.55" stroke-dasharray="3 6" />
              </g>
              <line class="mc-pipe" x1={x} y1="14" x2={x} y2={tip} pathLength="1" stroke="#e37a1d" stroke-width="2.5" />
              <rect x={x - 8} y="3" width="16" height="12" rx="2" fill="#e37a1d" />
            </g>
          ))}
        </svg>
      )
    }
    {
      work.id === "shinomontazh" && (
        <svg class="art-tire" viewBox="-300 -300 600 600">
          <defs>
            <path id="shino-sidewall" d="M0 -212 A212 212 0 1 1 -0.1 -212" />
          </defs>
          <g class="tire-settle">
            <g class="tire-spin">
              <circle r="296" fill="#141414" />
              <circle r="282" fill="none" stroke="#242424" stroke-width="24" pathLength="72" stroke-dasharray="0.6 0.4" />
              <circle r="262" fill="none" stroke="#1c1c1c" stroke-width="10" pathLength="72" stroke-dasharray="0.3 0.7" stroke-dashoffset="0.5" />
              <circle r="246" fill="#0e0e0e" stroke="#1f1f1f" stroke-width="2" />
              <text fill="#2a2a2a" font-size="21" font-weight="700" letter-spacing="7.5">
                <textPath href="#shino-sidewall">ШИНОМОНТАЖ · САНКТ-ПЕТЕРБУРГ · ШИНОМОНТАЖ · САНКТ-ПЕТЕРБУРГ ·</textPath>
              </text>
              <circle r="168" fill="#0a0a0a" stroke="#e60000" stroke-width="16" />
              <circle r="150" fill="none" stroke="#2a2a2a" stroke-width="2" />
              {spokes.map((deg) => (
                <path d="M-13 -46 L-24 -148 L24 -148 L13 -46Z" fill="#1d1d1d" stroke="#262626" transform={`rotate(${deg})`} />
              ))}
              <circle r="42" fill="#161616" stroke="#e60000" stroke-width="5" />
              {spokes.map((deg) => (
                <circle cy="-23" r="4.5" fill="#3a3a3a" transform={`rotate(${deg + 36})`} />
              ))}
            </g>
          </g>
          <circle r="292" fill="none" stroke="#fff" stroke-opacity="0.07" stroke-width="3" pathLength="100" stroke-dasharray="16 84" stroke-dashoffset="-56" />
        </svg>
      )
    }
    {
      work.id === "moyka" && (
        <svg class="art-band art-foam" viewBox="0 0 1440 160" preserveAspectRatio="xMaxYMax slice">
          <defs>
            <radialGradient id="moyka-bubble" fx="0.38" fy="0.32">
              <stop offset="0.55" stop-color="#7ee99a" stop-opacity="0" />
              <stop offset="1" stop-color="#7ee99a" stop-opacity="0.24" />
            </radialGradient>
          </defs>
          {foam.map((bubble) => (
            <g class="foam-bubble" style={`--d: ${bubble.delay}s`}>
              <circle cx={bubble.x} cy={bubble.y} r={bubble.r} fill="url(#moyka-bubble)" stroke="#7ee99a" stroke-opacity="0.4" stroke-width="1.2" />
              <path d={bubble.shine} fill="none" stroke="#fff" stroke-opacity="0.5" stroke-width="1.6" stroke-linecap="round" />
            </g>
          ))}
        </svg>
      )
    }
    {
      work.id === "ti-redesign" && (
        <svg class="art-band art-crack" viewBox="0 0 1440 160" preserveAspectRatio="xMaxYMax slice">
          <defs>
            <pattern id="ti-hatch" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="14" stroke="#fff" stroke-opacity="0.07" stroke-width="1.5" />
            </pattern>
          </defs>
          <rect y="34" width="1440" height="126" fill="#1d2225" />
          <rect y="34" width="1440" height="126" fill="url(#ti-hatch)" />
          <line x1="0" y1="34" x2="1440" y2="34" stroke="#80878b" stroke-opacity="0.7" stroke-width="1.5" />
          <path d={crackPath} fill="none" stroke="#111416" stroke-width="5" stroke-linejoin="round" />
          <path class="ti-resin" d={crackPath} pathLength="1" fill="none" stroke="#00ff02" stroke-width="2.2" stroke-linejoin="round" />
          {packers.map((packer) => (
            <g>
              <line x1={packer.x} y1={packer.y} x2={packer.x} y2={packer.onCrack} stroke="#b4bbbe" stroke-opacity="0.35" stroke-dasharray="3 3" />
              <circle cx={packer.x} cy={packer.y} r="9" fill="#262c2f" stroke="#80878b" stroke-width="1.5" />
              <circle class="ti-packer" cx={packer.x} cy={packer.y} r="3.2" style={`--d: ${packer.delay}s`} />
            </g>
          ))}
          <polyline
            points={`${labelled.x - 6} ${labelled.y - 8} ${labelled.x - 30} 16 ${labelled.x - 80} 16`}
            fill="none"
            stroke="#b4bbbe"
            stroke-opacity="0.6"
          />
          <text x={labelled.x - 86} y="20" text-anchor="end" fill="#b4bbbe" font-size="13" class="ti-label">
            пакер
          </text>
        </svg>
      )
    }
  </div>

  <div class="container-page relative pt-6 pb-36 sm:pt-10 sm:pb-40 lg:pt-14 lg:pb-48">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <a href="/#works" class="group inline-flex min-h-11 items-center gap-2 text-paper/85 hover:text-paper">
        <Icon name="arrow-left" class="size-4 transition-transform duration-300 group-hover:-translate-x-1" />
        <span class="link-line link-line-dark">Все работы</span>
      </a>
      <span class="cover-muted font-mono text-[0.8125rem]">Кейс {num(index)} из {String(total).padStart(2, "0")}</span>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:mt-12 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="lg:col-span-8">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="cover-muted font-mono text-[0.8125rem]">{work.industry}</span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-paper/20 bg-paper/10 px-2.5 py-0.5 text-xs font-medium text-paper">
            {work.status.tone === "live" && <span class="size-1.5 animate-pulse rounded-full bg-[#4ade80] motion-reduce:animate-none" aria-hidden="true" />}
            {work.status.label}
          </span>
        </div>
        <h1
          id="case-title"
          class="mt-4 text-[clamp(2rem,10vw,2.5rem)] leading-[1.04] font-bold tracking-[-0.035em] text-balance text-paper sm:text-6xl xl:text-7xl"
          set:html={typo(work.title)}
        />
      </div>
      <div class="lg:col-span-4">
        <p class="text-lg leading-relaxed text-paper/85" set:html={typo(work.kind)} />
        <a href={work.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost-dark mt-6">
          {work.status.tone === "concept" ? "Открыть концепт" : "Открыть сайт"}
          <Icon name="arrow-up-right" class="size-4" />
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cover {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  /* Подписи на обложке: на всех фонах контраст не ниже 5:1. */
  .cover-muted {
    color: rgb(243 242 236 / 0.8);
  }
  .cover-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  /* Сцена — полоса внизу обложки, под текстом (отступ снизу у текста
     на 1,5–2rem больше полосы). На узком экране окно сайта во всю ширину
     и заходит на полосу неглубоко, на широком — закрывает её левую часть. */
  .art-band {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    width: 100%;
    height: 7.5rem;
  }
  @media (min-width: 640px) {
    .art-band {
      height: 8.5rem;
    }
  }
  @media (min-width: 1024px) {
    .art-band {
      height: 10rem;
    }
  }

  /* MC-PROJECT: синий MC, под землёй — слои грунта, оранжевые инъекторы
     и смола, которая расширяется вокруг их концов. */
  .cover-mc-project {
    background: linear-gradient(180deg, #00507f 0%, #003a5c 100%);
  }
  .art-mc .mc-bulb {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Шиномонтаж: ночь, красная подсветка вывески, колесо с красным диском. */
  .cover-shinomontazh {
    background:
      radial-gradient(42rem 28rem at 88% 78%, rgb(230 0 0 / 0.3), transparent 70%),
      radial-gradient(30rem 16rem at 12% 0%, rgb(255 59 48 / 0.08), transparent 70%),
      #070707;
  }
  /* Колесо выглядывает снизу, как из-под пола: видна верхняя дуга —
     протектор, надпись на боковине и красный диск. На узком экране окно
     закрывает полосу почти целиком, поэтому колесо меньше и поднимается
     до кнопки — справа от неё. */
  .art-tire {
    position: absolute;
    right: -4rem;
    bottom: calc(10.5rem - 20rem);
    width: 20rem;
  }
  @media (min-width: 640px) {
    .art-tire {
      right: 1rem;
      bottom: calc(11.5rem - 22rem);
      width: 22rem;
    }
  }
  @media (min-width: 1024px) {
    .art-tire {
      right: 2rem;
      bottom: calc(10rem - 40rem);
      width: 40rem;
    }
  }

  /* Мойка: темнота бокса, зелёный неон вывески сверху и пена внизу. */
  .cover-moyka {
    background:
      radial-gradient(38rem 22rem at 86% 0%, rgb(51 211 90 / 0.22), transparent 70%),
      radial-gradient(60rem 14rem at 70% 100%, rgb(51 211 90 / 0.1), transparent 70%),
      #070908;
  }

  /* ТИ: графит их сайта и сетка чертежа; внизу — разрез стены с трещиной. */
  .cover-ti-redesign {
    background-color: #22282b;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.065) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.065) 1px, transparent 1px),
      linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px);
    background-size:
      120px 120px,
      120px 120px,
      24px 24px,
      24px 24px;
    background-position: center top;
  }
  .art-crack .ti-resin {
    filter: drop-shadow(0 0 5px rgb(0 255 2 / 0.7));
  }
  .art-crack .ti-packer {
    fill: #00ff02;
  }
  .art-crack .ti-label {
    font-family: var(--font-mono);
  }

  /* Тёмная карточка результата на странице — в тёмный цвет сайта. У
     шиномонтажа и мойки он и так почти чёрный. */
  :global(main:has(> .cover-mc-project)) {
    --case-deep: #003a5c;
  }

  @media (prefers-reduced-motion: no-preference) {
    .art-mc .mc-pipe {
      stroke-dasharray: 1;
      animation: cover-draw 0.7s var(--ease-out) calc(0.3s + var(--i) * 0.2s) both;
    }
    .art-mc .mc-bulb {
      animation: cover-grow 1.8s var(--ease-out-expo) calc(0.85s + var(--i) * 0.2s) both;
    }

    .tire-settle {
      animation: cover-settle 1.6s var(--ease-out-expo) 0.2s both;
    }
    /* Шкала прокрутки — отдельным правилом: в одном правиле минификатор
       сворачивает её в сокращённое animation, где она недопустима, и
       браузер выбрасывает всё объявление. */
    @supports (animation-timeline: scroll()) {
      .tire-spin {
        animation: cover-spin linear both;
      }
      .art-tire .tire-spin {
        animation-timeline: scroll(root);
        animation-range: 0 120vh;
      }
    }

    .foam-bubble {
      animation: cover-rise 1.6s var(--ease-out-expo) var(--d) both;
    }

    .art-crack .ti-resin {
      stroke-dasharray: 1;
      animation: cover-draw 2.8s linear 0.4s both;
    }
    .art-crack .ti-packer {
      animation: cover-light 0.4s var(--ease-out) var(--d) both;
    }
  }

  @keyframes cover-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes cover-grow {
    from {
      opacity: 0;
      scale: 0.15;
    }
  }
  @keyframes cover-settle {
    from {
      rotate: -70deg;
    }
  }
  @keyframes cover-spin {
    to {
      rotate: 240deg;
    }
  }
  @keyframes cover-rise {
    from {
      opacity: 0;
      translate: 0 48px;
    }
  }
  @keyframes cover-light {
    from {
      fill: #80878b;
    }
  }
</style>
