---
import BrowserFrame from "./BrowserFrame.astro";
import PhoneFrame from "./PhoneFrame.astro";
import Icon from "./Icon.astro";
import MetricValue from "./MetricValue.astro";
import { facts, works } from "../data/works";
import { typo } from "../lib/typo";
import { phone } from "../data/site";

const mc = works.find((w) => w.id === "mc-project")!;
const moyka = works.find((w) => w.id === "moyka")!;
const shino = works.find((w) => w.id === "shinomontazh")!;
---

<section id="top" aria-labelledby="hero-title" class="relative">
  <div class="container-page grid gap-14 pt-10 pb-16 sm:pt-14 lg:grid-cols-12 lg:items-center lg:gap-8 lg:pt-16 lg:pb-20">
    <div class="lg:col-span-6 xl:col-span-6">
      <p class="eyebrow text-muted">Максим — веб-разработчик</p>
      <h1 id="hero-title" class="mt-5 font-bold tracking-[-0.035em]">
        <span class="block text-[3.25rem] leading-[1.02] sm:text-7xl xl:text-[5.25rem]">
          Сайты <span class="marker whitespace-nowrap">под ключ</span>
        </span>
        <span class="mt-3 block text-[1.75rem] leading-tight tracking-[-0.025em] text-ink-2 sm:text-4xl xl:text-[2.625rem]">
          от&nbsp;идеи до&nbsp;первых заявок
        </span>
      </h1>
      <p
        class="mt-7 max-w-[34rem] text-lg leading-relaxed text-ink-2 sm:text-xl sm:leading-relaxed"
        set:html={typo(
          "Беру на себя всё: структуру, дизайн, разработку, формы, аналитику, хостинг и поддержку. Вы получаете сайт, который быстро открывается, не теряет заявки и легко правится.",
        )}
      />
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#contact" class="btn btn-primary">Обсудить проект</a>
        <a href="#works" class="btn btn-secondary">
          Смотреть работы
          <Icon name="arrow-down" class="size-4" />
        </a>
      </div>
      <p class="mt-6 text-[0.9375rem] text-muted">
        Или сразу позвоните:{" "}
        <a href={phone.href} class="font-medium text-ink underline decoration-ink/30 underline-offset-4 hover:decoration-ink"
          >{phone.display}</a
        >
      </p>
    </div>

    {/* Три работы одним кадром: окно позади видно только на широком экране,
        на телефоне остаются главное окно и телефон. */}
    <div class="relative lg:col-span-6 xl:col-span-6" aria-label="Примеры работ" role="group">
      <div class="relative mx-auto max-w-[38rem] pb-8 lg:mr-0 lg:max-w-none lg:pt-14 lg:pb-10">
        <BrowserFrame
          src={moyka.desktop}
          alt=""
          url={moyka.urlLabel}
          sizes="26rem"
          class="absolute top-0 right-0 hidden w-[68%] lg:block"
        />
        <BrowserFrame
          src={mc.desktop}
          alt={`Главный экран сайта ${mc.urlLabel}`}
          url={mc.urlLabel}
          sizes="(min-width: 1280px) 34rem, (min-width: 1024px) 44vw, (min-width: 640px) 36rem, 92vw"
          priority
          class="relative lg:w-[86%]"
        />
        <PhoneFrame
          src={shino.mobile}
          alt={`Сайт ${shino.urlLabel} на телефоне`}
          sizes="(min-width: 1024px) 9rem, 24vw"
          eager
          class="absolute right-[3%] bottom-0 w-[25%] lg:right-0 lg:w-[23%]"
        />
      </div>
    </div>
  </div>

  <div class="border-y border-line bg-surface">
    <dl class="container-page grid grid-cols-2 lg:grid-cols-4">
      {
        facts.map((fact, i) => (
          <div
            class:list={[
              "flex flex-col gap-2 py-6 sm:py-8",
              i % 2 === 1 && "border-l border-line pl-5 sm:pl-8",
              i % 2 === 0 && "pr-5 sm:pr-8",
              i >= 2 && "border-t border-line lg:border-t-0",
              i === 2 && "lg:border-l lg:pl-8",
            ]}
          >
            <dt class="order-2 text-sm leading-snug text-muted" set:html={typo(fact.label)} />
            <dd class="order-1 font-mono text-2xl font-semibold tracking-tight whitespace-nowrap sm:text-3xl">
              <MetricValue value={fact.value} />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
