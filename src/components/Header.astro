---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { contact, nav, phone, site } from "../data/site";

const telegram = contact("telegram");
// На страницах кейсов разделы меню — на главной. Контакты есть внизу любой
// страницы, поэтому эта ссылка остаётся на месте.
const home = Astro.url.pathname === "/";
const link = (href: string) => (home || href === "#contact" ? href : `/${href}`);
---

<header class="sticky top-0 z-30 border-b border-transparent bg-paper/90 backdrop-blur-md" data-header>
  {/* Сколько страницы прочитано — жёлтая полоса по нижнему краю (motion.ts). */}
  <span class="pointer-events-none absolute inset-x-0 -bottom-px h-[3px] origin-left scale-x-0 bg-accent" aria-hidden="true" data-progress></span>
  <div class="container-page flex h-16 items-center gap-3 sm:gap-4 lg:h-[4.5rem]">
    <a href={home ? "#top" : "/"} class="group -m-1 flex items-center gap-3 rounded-lg p-1">
      <Logo class="h-7 w-auto lg:h-8" />
      <span class="leading-tight">
        <span class="block text-[1.0625rem] font-semibold tracking-tight">{site.name}</span>
        <span class="block text-xs text-muted">сайты под ключ</span>
        <span class="sr-only">{home ? "- в начало страницы" : "- на главную"}</span>
      </span>
    </a>

    <nav aria-label="Разделы страницы" class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a href={link(item.href)} class="nav-link block rounded-lg px-3 py-2 text-[0.9375rem] text-ink-2 transition-colors duration-200 hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-4">
      <button
        type="button"
        class="sound-toggle size-11 place-items-center rounded-full border border-line bg-surface text-ink transition-[border-color,background-color,color] duration-300 hover:border-ink hover:bg-ink hover:text-paper"
        aria-pressed="true"
        aria-label="Звук при нажатиях"
        title="Звук при нажатиях"
        data-sound-toggle
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"></path>
          <path class="sound-on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path>
          <path class="sound-off" d="m16 9.5 5 5m0-5-5 5"></path>
        </svg>
      </button>
      <a
        href={telegram.href}
        target="_blank"
        rel="noopener noreferrer"
        class="grid size-11 place-items-center rounded-full border border-line bg-surface text-ink transition-[border-color,background-color,color] duration-300 hover:border-ink hover:bg-ink hover:text-paper"
        title={telegram.title}
        data-magnetic
      >
        <Icon name="telegram" class="size-5" label={`${telegram.title} (откроется в новой вкладке)`} />
      </a>
      <a href={phone.href} class="btn btn-primary h-11 min-h-11 px-3.5 text-sm sm:px-4" title={`Позвонить: ${phone.display}`}>
        <Icon name="phone" class="size-4" />
        {/* Уже 360 px строка не вмещает логотип, Telegram и подпись — остаётся значок. */}
        <span class="max-[359px]:sr-only sm:hidden">Позвонить</span>
        <span class="hidden sm:inline">{phone.display}</span>
      </a>
    </div>
  </div>
</header>
