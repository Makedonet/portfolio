---
// Остальные работы под главным кейсом: клиент, отрасль и главное, что дал сайт, —
// по строке на работу. Строка ведёт на страницу кейса. При наведении мышью
// строка заливается жёлтым, а за курсором плывёт превью сайта
// (scripts/works-index.ts): пружина, наклон от скорости, смена картинки
// сдвигом. На телефоне превью нет — миниатюра стоит прямо в строке и при
// переходе перетекает в окно на странице кейса (data-vt, Layout.astro).
import { Picture, getImage } from "astro:assets";
import Icon from "./Icon.astro";
import { caseUrl, type Work } from "../data/works";
import { scene } from "../data/live";
import { typo } from "../lib/typo";

interface Props {
  works: Work[];
}

const { works } = Astro.props;

const rows = await Promise.all(
  works.map(async (work) => {
    const poster = scene(work.screens.desktop[0]!).poster;
    // Превью нужно только под курсором — адреса в data-атрибутах, грузит скрипт.
    const avif = await getImage({ src: poster, widths: [400, 800], format: "avif", quality: 55 });
    const webp = await getImage({ src: poster, widths: [400, 800], format: "webp", quality: 72 });
    return { work, poster, avif: avif.srcSet.attribute, webp };
  }),
);
---

<div class="works-index border-y border-line bg-surface" data-works-index>
  <h3 class="sr-only">Другие работы</h3>
  <ol class="container-page" data-stagger>
    {
      rows.map(({ work, poster }, i) => (
        <li class="index-row">
          <a href={caseUrl(work.id)} class="index-link" data-index-row={i}>
            <span class="index-fill" aria-hidden="true" />
            <Picture
              src={poster}
              alt=""
              widths={[176, 264]}
              sizes="88px"
              formats={["avif"]}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
              class="index-thumb"
              data-vt={work.id}
            />
            <span class="index-name">
              {work.logo && <img src={work.logo.src} alt="" width="44" height="44" loading="lazy" decoding="async" class="index-logo" />}
              <span set:html={typo(work.title)} />
            </span>
            <span class="index-industry">{work.industry}</span>
            <span class="index-result" set:html={typo(work.highlight)} />
            <Icon name="arrow-right" class="index-arrow" />
          </a>
        </li>
      ))
    }
  </ol>
  <div class="index-preview" aria-hidden="true" data-index-preview>
    <div class="index-preview-track" data-index-track>
      {
        rows.map(({ avif, webp }) => (
          <picture>
            <source type="image/avif" data-srcset={avif} sizes="22rem" />
            <img data-srcset={webp.srcSet.attribute} data-src={webp.src} sizes="22rem" alt="" width="400" height="250" decoding="async" data-index-image />
          </picture>
        ))
      }
    </div>
    <span class="index-preview-label">Смотреть кейс</span>
  </div>
</div>

<style>
  .works-index {
    position: relative;
    overflow-x: clip;
  }
  .index-row + .index-row {
    border-top: 1px solid var(--color-line);
  }
  /* Телефон: миниатюра слева, справа — отрасль, название и итог. */
  .index-link {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    grid-template-areas:
      "thumb industry"
      "thumb name"
      "thumb result";
    column-gap: 1rem;
    align-items: center;
    padding-block: 1.1rem;
  }
  .index-fill {
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.55s var(--ease-out-expo);
  }
  .index-thumb {
    grid-area: thumb;
    width: 5.5rem;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: 0.5rem;
    box-shadow: 0 0 0 1px rgb(17 17 16 / 0.1);
  }
  .index-name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.05;
    display: flex;
    align-items: center;
    gap: 0.3em;
  }
  .index-logo {
    flex: none;
    width: 1em;
    height: 1em;
  }
  .index-industry {
    grid-area: industry;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .index-result {
    grid-area: result;
    margin-top: 0.15rem;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--color-ink-2);
  }
  .index-link :global(.index-arrow) {
    display: none;
  }

  /* Широкий экран: строка-таблица, миниатюры нет — её место занимает превью. */
  @media (min-width: 1024px) {
    .index-link {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.45fr) minmax(0, 1.4fr) 1.5rem;
      grid-template-areas: "name industry result arrow";
      column-gap: 1.5rem;
      padding-block: 1.5rem;
    }
    .index-thumb {
      display: none;
    }
    .index-name {
      font-size: clamp(2rem, 3.1vw, 2.75rem);
      transition: translate 0.5s var(--ease-out-expo);
    }
    .index-industry {
      font-size: 0.9375rem;
    }
    .index-result {
      margin-top: 0;
      font-size: 1rem;
    }
    .index-link :global(.index-arrow) {
      grid-area: arrow;
      display: block;
      width: 1.25rem;
      height: 1.25rem;
      transition: translate 0.45s var(--ease-out-expo);
    }
    .index-link:hover .index-fill,
    .index-link:focus-visible .index-fill {
      transform: scaleY(1);
    }
    .index-link:hover .index-name {
      translate: 0.6rem 0;
    }
    .index-link:hover :global(.index-arrow) {
      translate: 0.25rem 0;
    }
    .index-link:hover .index-industry {
      color: var(--color-ink-2);
    }
  }

  /* Превью за курсором — только с мышью и движением (класс ставит скрипт). */
  .index-preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: 22rem;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-ink);
    box-shadow:
      0 0 0 1px rgb(17 17 16 / 0.12),
      0 1.5rem 3rem -1rem rgb(17 17 16 / 0.45);
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
  }
  :global(.index-live) .index-preview {
    visibility: visible;
  }
  .index-preview-track {
    height: 100%;
  }
  .index-preview-track :global(picture),
  .index-preview-track img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .index-preview-track img {
    object-fit: cover;
    object-position: top;
  }
  .index-preview-label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font: 500 0.8125rem/1.2 var(--font-sans);
  }
</style>
