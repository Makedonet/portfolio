---
import SectionHead from "./SectionHead.astro";
import WorkCase from "./WorkCase.astro";
import DemoCard from "./DemoCard.astro";
import { demos, works } from "../data/works";
---

<section aria-labelledby="works-title" id="works" class="scroll-mt-16 pt-20 sm:pt-28">
  <div class="container-page">
    <SectionHead
      id="works-title"
      title="Сайты для реального бизнеса"
      intro="Три сайта действующих компаний и концепт редизайна. В окнах сайты листаются сами, а колёсиком мыши их можно прокрутить, как настоящие. Цифры — из замеров, а не из головы."
    />

    <div class="mt-12 sm:mt-16">
      {works.map((work, index) => <WorkCase work={work} index={index} />)}
    </div>

    <div class="border-t border-line pt-14 pb-20 sm:pt-20 sm:pb-28">
      <h3 class="text-3xl font-bold tracking-[-0.025em] sm:text-[2.125rem]" data-split>Демо-проекты</h3>
      <div class="mt-10 grid gap-16 md:grid-cols-2 md:gap-10 lg:gap-14">
        {demos.map((demo, index) => <DemoCard demo={demo} index={index} />)}
      </div>
    </div>
  </div>
</section>
