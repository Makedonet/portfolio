---
import SectionHead from "./SectionHead.astro";
import WorkCase from "./WorkCase.astro";
import DemoCard from "./DemoCard.astro";
import { demos, works } from "../data/works";
---

<section aria-labelledby="works-title" id="works" class="scroll-mt-16 pt-20 sm:pt-28">
  <div class="container-page">
    <SectionHead
      id="works-title"
      index="01"
      eyebrow="Работы"
      title="Сайты для реального бизнеса"
      intro="Три сайта действующих компаний и концепт редизайна. У каждого — что сделано и цифры из замеров, а не из головы."
    />

    <div class="mt-12 sm:mt-16">
      {works.map((work, index) => <WorkCase work={work} index={index} />)}
    </div>

    <div class="border-t border-line pt-14 pb-20 sm:pt-20 sm:pb-28">
      <h3 class="eyebrow text-muted" data-reveal>Демо-проекты</h3>
      <div class="mt-8 grid gap-14 md:grid-cols-2 md:gap-10 lg:gap-14">
        {demos.map((demo, i) => <DemoCard demo={demo} delay={i * 80} />)}
      </div>
    </div>
  </div>
</section>
