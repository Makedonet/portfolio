---
// Работы на главной — превью: первый кейс крупно, остальные карточками в ряд,
// ниже демо. Подробности каждого кейса — на его странице (WorkCard.astro).
import SectionHead from "./SectionHead.astro";
import WorkCard from "./WorkCard.astro";
import DemoCard from "./DemoCard.astro";
import { demos, works } from "../data/works";
import { typo } from "../lib/typo";

const [lead, ...rest] = works;
---

<section aria-labelledby="works-title" id="works" class="scroll-mt-16 pt-20 sm:pt-28">
  <div class="container-page">
    <SectionHead
      id="works-title"
      title="Сайты для реального бизнеса"
      intro="Три сайта работающих компаний и концепт редизайна. Сайты в окнах листаются сами, а колёсиком мыши их можно прокрутить, как настоящие. Все цифры - из реальных замеров и данных заказчиков."
    />

    <div class="mt-12 border-t border-line py-14 sm:mt-16 sm:py-16">
      {lead && <WorkCard work={lead} index={0} featured />}
    </div>

    <div class="grid gap-16 border-t border-line py-14 sm:py-16 lg:grid-cols-3 lg:gap-10 xl:gap-12">
      {rest.map((work, i) => <WorkCard work={work} index={i + 1} />)}
    </div>

    <div class="grid gap-16 border-t border-line pt-14 pb-20 sm:pt-16 sm:pb-28 lg:grid-cols-3 lg:gap-10 xl:gap-12">
      <div>
        <h3 class="font-display text-[2.75rem] leading-none font-bold sm:text-[3.25rem]" data-split>Демо-проекты</h3>
        <p
          class="mt-4 max-w-sm leading-relaxed text-ink-2"
          data-fade
          set:html={typo("Два лендинга в демо-режиме: можно открыть сайт и посмотреть код на GitHub.")}
        />
      </div>
      {demos.map((demo, index) => <DemoCard demo={demo} index={index} />)}
    </div>
  </div>
</section>
