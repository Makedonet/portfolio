---
// Работы на главной: главный кейс крупно (WorkCard.astro), остальные — строками
// (WorksIndex.astro), демо — ссылками. Подробности каждого кейса — на его странице.
import SectionHead from "./SectionHead.astro";
import WorkCard from "./WorkCard.astro";
import WorksIndex from "./WorksIndex.astro";
import Icon from "./Icon.astro";
import { demos, works } from "../data/works";

const [lead, ...rest] = works;
---

<section aria-labelledby="works-title" id="works" class="pt-16 sm:pt-24">
  <div class="container-page">
    <SectionHead id="works-title" title="Сайты для реального бизнеса" intro="Все цифры - из реальных замеров и данных заказчиков." />
    <div class="py-10 sm:py-14">
      {lead && <WorkCard work={lead} />}
    </div>
  </div>

  <WorksIndex works={rest} />

  <div class="container-page flex flex-wrap items-center gap-x-8 gap-y-1 py-5 text-[0.9375rem]">
    <p class="text-muted">Ещё демо:</p>
    {
      demos.map((demo) => (
        <a href={demo.url} target="_blank" rel="noopener noreferrer" class="group inline-flex min-h-11 items-center gap-2">
          <span class="link-line font-semibold">{demo.title}</span>
          <span class="text-muted">{demo.kind}</span>
          <Icon name="arrow-up-right" class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" />
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>
      ))
    }
  </div>
</section>
