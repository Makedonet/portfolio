---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { steps } from "../data/steps";
import { typo } from "../lib/typo";

// Файлы роликов — с хешем в имени, поэтому кэшируются навсегда, как и всё в _astro.
const videos = import.meta.glob<string>("../assets/process/*.mp4", { eager: true, query: "?url", import: "default" });
const posters = import.meta.glob<{ default: ImageMetadata }>("../assets/process/*.png", { eager: true });

const clipSizes = "(min-width: 1280px) 42rem, (min-width: 1024px) 52vw, calc(100vw - 2.5rem)";
---

<section aria-labelledby="process-title" id="process" class="py-20 sm:py-28">
  <div class="container-page">
    <SectionHead
      id="process-title"
      title="Как работаю"
      intro="Всё делаю сам: не нужно искать отдельно дизайнера, программиста и того, кто «подключит формы». На каждом шаге вы видите результат и можете внести правки."
    />

    {/* Один кадр на все шаги: ролики идут сериями, один сайт проходит весь путь,
        а шаг можно выбрать нажатием, кнопками или свайпом (scripts/clips.ts).
        Текст всех шагов виден сразу, так что без скрипта и при «уменьшить движение»
        теряется только движение. Кадр и список — не сеткой на телефоне: в сетке
        липкий кадр не вышел бы за свою строку. */}
    <div class="mt-10 sm:mt-14 lg:grid lg:grid-cols-12 lg:items-center lg:gap-14" data-steps>
      <div class="clip-player lg:order-2 lg:col-span-7">
        <div class="clip relative" data-clip-frame>
          {
            steps.map((step, i) => (
              <div class:list={["clip-layer absolute inset-0", i === 0 && "is-current"]} role="img" aria-label={step.clipLabel} data-clip>
                <Picture
                  src={posters[`../assets/process/${step.clip}.png`]!.default}
                  alt=""
                  widths={[480, 720, 960, 1440]}
                  sizes={clipSizes}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover"
                />
                {/* Адреса — в data-: ролик качается, только когда до него дошла очередь. */}
                <video class="clip-video absolute inset-0 h-full w-full object-cover" width="1440" height="960" muted playsinline disablepictureinpicture preload="none" tabindex="-1">
                  <source data-src={videos[`../assets/process/${step.clip}.av1.mp4`]} type='video/mp4; codecs="av01.0.08M.08"' />
                  <source data-src={videos[`../assets/process/${step.clip}.h264.mp4`]} type="video/mp4" />
                </video>
              </div>
            ))
          }
        </div>

        <div class="mt-2 flex items-center gap-2 sm:mt-3">
          <button type="button" class="clip-control" aria-label="Предыдущий шаг" data-clip-prev>
            <Icon name="arrow-right" class="size-4 rotate-180" />
          </button>
          <button type="button" class="clip-control" aria-label="Следующий шаг" data-clip-next>
            <Icon name="arrow-right" class="size-4" />
          </button>
          <p class="min-w-0 flex-1 pl-1 text-[0.9375rem] leading-tight text-ink-2">
            Шаг <span data-clip-count>1</span> из {steps.length}
            <span class="block truncate font-semibold text-ink sm:ml-1 sm:inline" data-clip-name>{steps[0]!.title}</span>
          </p>
          <button
            type="button"
            class="clip-control clip-toggle"
            data-clip-toggle
            data-label-pause="Остановить ролик"
            data-label-play="Запустить ролик"
            aria-label="Остановить ролик"
          >
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
              <path class="clip-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
              <path class="clip-play hidden" d="M8 5.5v13l10.5-6.5z" />
            </svg>
          </button>
        </div>
      </div>

      <ol class="mt-6 lg:order-1 lg:col-span-5 lg:mt-0">
        {
          steps.map((step, i) => (
            <li class:list={["step", i === 0 && "is-current"]} style={`--i: ${i}`} data-step data-cursor="Показать этот шаг">
              <span class="step-dot" aria-hidden="true">
                <span class="step-digit">{i + 1}</span>
              </span>
              <span class="step-line" aria-hidden="true" />
              <div>
                <h3 class="step-heading font-display text-[1.75rem] leading-tight font-bold">
                  <button type="button" class="step-button" aria-current={i === 0 ? "step" : undefined} data-step-button>
                    <span class="sr-only">Шаг {i + 1}. </span>
                    <span class="step-title">{step.title}</span>
                  </button>
                </h3>
                <p class="mt-1 leading-snug text-ink-2" set:html={typo(step.text)} />
              </div>
              <span class="step-chip" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5.5v13l10.5-6.5z" />
                </svg>
                <span class="step-bars">
                  <i />
                  <i />
                  <i />
                </span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-5 sm:mt-12" data-fade>
      <p class="max-w-xl text-lg leading-snug" set:html={typo("Уже есть сайт? Могу обновить его, не меняя адреса страниц, чтобы не потерять позиции в поиске.")} />
      <a href="/services/" class="btn btn-secondary">
        Что входит в работу
        <Icon name="arrow-right" class="size-4" />
      </a>
    </div>
  </div>
</section>
