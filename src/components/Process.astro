---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { steps } from "../data/steps";
import { typo } from "../lib/typo";

// Файлы роликов — с хешем в имени, поэтому кэшируются навсегда, как и всё в _astro.
const videos = import.meta.glob<string>("../assets/process/*.mp4", { eager: true, query: "?url", import: "default" });
const posters = import.meta.glob<{ default: ImageMetadata }>("../assets/process/*.png", { eager: true });

const clipSizes = "(min-width: 1280px) 42rem, (min-width: 1024px) 52vw, calc(100vw - 2.5rem)";
---

<section aria-labelledby="process-title" id="process" class="py-20 sm:py-28">
  <div class="container-page">
    <SectionHead
      id="process-title"
      title="Пять шагов от разговора до запуска"
      intro="Всё делаю сам: не нужно искать отдельно дизайнера, программиста и того, кто «подключит формы». На каждом шаге вы видите результат и можете внести правки."
    />

    {/* Один кадр на все шаги: ролики идут сериями, один сайт проходит весь путь,
        а шаг можно выбрать нажатием (scripts/clips.ts). Текст всех шагов виден
        сразу, так что без скрипта и при «уменьшить движение» теряется только
        движение. */}
    <div class="mt-10 grid gap-8 sm:mt-14 lg:grid-cols-12 lg:items-center lg:gap-14">
      <div class="clip relative lg:order-2 lg:col-span-7" data-clip-frame>
        {
          steps.map((step, i) => (
            <div class:list={["clip-layer absolute inset-0", i === 0 && "is-current"]} role="img" aria-label={step.clipLabel} data-clip>
              <Picture
                src={posters[`../assets/process/${step.clip}.png`]!.default}
                alt=""
                widths={[480, 720, 960, 1440]}
                sizes={clipSizes}
                formats={["avif"]}
                fallbackFormat="webp"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
              {/* Адреса — в data-: ролик качается, только когда до него дошла очередь. */}
              <video class="clip-video absolute inset-0 h-full w-full object-cover" width="1440" height="960" muted playsinline disablepictureinpicture preload="none" tabindex="-1">
                <source data-src={videos[`../assets/process/${step.clip}.av1.mp4`]} type='video/mp4; codecs="av01.0.08M.08"' />
                <source data-src={videos[`../assets/process/${step.clip}.h264.mp4`]} type="video/mp4" />
              </video>
            </div>
          ))
        }
        <button
          type="button"
          class="clip-toggle absolute right-0 bottom-0 size-11 place-items-center text-paper md:right-1 md:bottom-1"
          data-clip-toggle
          data-label-pause="Остановить ролик"
          data-label-play="Запустить ролик"
          aria-label="Остановить ролик"
        >
          <svg viewBox="0 0 24 24" class="clip-toggle-disc size-7 rounded-full p-1.5 md:size-8 md:p-2" fill="currentColor" aria-hidden="true">
            <path class="clip-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
            <path class="clip-play hidden" d="M8 5.5v13l10.5-6.5z" />
          </svg>
        </button>
      </div>

      <ol class="lg:order-1 lg:col-span-5">
        {
          steps.map((step, i) => (
            <li class:list={["step", i === 0 && "is-current"]} data-step>
              <span class="step-dot grid size-[2.25rem] place-items-center rounded-full border border-line bg-paper text-sm font-semibold text-ink" aria-hidden="true">
                {i + 1}
              </span>
              <span class="step-line" aria-hidden="true" />
              <div>
                <h3 class="font-display text-[1.75rem] leading-tight font-bold">
                  <button type="button" class="step-button" aria-current={i === 0 ? "step" : undefined} data-step-button>
                    <span class="sr-only">Шаг {i + 1}. </span>
                    <span class="step-title">{step.title}</span>
                  </button>
                </h3>
                <p class="mt-1 leading-snug text-ink-2" set:html={typo(step.text)} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="mt-8 text-lg leading-snug sm:mt-12" data-fade set:html={typo("Уже есть сайт? Могу обновить его, не меняя адреса страниц, чтобы не потерять позиции в поиске.")} />
  </div>
</section>
