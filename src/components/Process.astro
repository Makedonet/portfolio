---
import SectionHead from "./SectionHead.astro";
import { steps } from "../data/services";
import { typo } from "../lib/typo";
---

<section aria-labelledby="process-title" id="process" class="scroll-mt-16 py-20 sm:py-28">
  <div class="container-page">
    <SectionHead
      id="process-title"
      title="Пять шагов от разговора до запуска"
      intro="На каждом этапе вы видите результат и можете внести правки, прежде чем мы двинемся дальше."
    />

    {/* Линия дорисовывается при прокрутке, кружки загораются, когда она до них
        доходит (motion.ts). На телефоне шаги идут столбцом, на широком экране —
        строкой. Без скрипта линия просто видна целиком. */}
    <div class="relative mt-12 sm:mt-16" data-process>
      <span
        class="absolute top-2 bottom-2 left-[1.0625rem] w-px origin-top bg-line lg:top-[1.0625rem] lg:right-0 lg:bottom-auto lg:left-0 lg:h-px lg:w-auto lg:origin-left"
        aria-hidden="true"></span>
      <span
        class="absolute top-2 bottom-2 left-[1.0625rem] w-[2px] -translate-x-[0.5px] origin-top bg-ink lg:top-[1.0625rem] lg:right-0 lg:bottom-auto lg:left-0 lg:h-[2px] lg:w-auto lg:origin-left lg:translate-x-0 lg:-translate-y-[0.5px]"
        aria-hidden="true"
        data-process-line></span>
      <ol class="relative grid gap-10 lg:grid-cols-5 lg:gap-8" data-stagger>
        {
          steps.map((step, i) => (
            <li class="grid grid-cols-[2.25rem_1fr] gap-x-5 lg:block" data-step>
              <span
                class="step-dot grid size-[2.25rem] place-items-center rounded-full border border-line bg-paper text-sm font-semibold text-ink"
                aria-hidden="true"
                data-step-dot
              >
                {i + 1}
              </span>
              <div class="lg:mt-6">
                <h3 class="font-display text-[1.75rem] leading-tight font-bold">
                  <span class="sr-only">Шаг {i + 1}. </span>
                  {step.title}
                </h3>
                <p class="mt-2 leading-relaxed text-ink-2" set:html={typo(step.text)} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
