---
// Скриншот сайта в рамке окна браузера: строка с адресом подписывает, чей
// это экран, ещё до того, как прочитан текст рядом.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  url: string;
  sizes: string;
  /** Картинка видна на первом экране — грузить сразу, без lazy. */
  eager?: boolean;
  /** Главная картинка первого экрана (LCP) — поднять приоритет загрузки. */
  priority?: boolean;
  class?: string;
}

const { src, alt, url, sizes, eager = false, priority = false, class: className } = Astro.props;
---

<div
  class:list={[
    "overflow-hidden rounded-xl bg-surface shadow-[0_1px_2px_rgb(17_17_16/0.06),0_12px_32px_-8px_rgb(17_17_16/0.18)] ring-1 ring-ink/10",
    className,
  ]}
>
  <div class="flex h-7 items-center gap-1.5 border-b border-line bg-[#f8f7f3] px-3 sm:h-8" aria-hidden="true">
    <span class="size-2 rounded-full bg-[#e2dfd6]"></span>
    <span class="size-2 rounded-full bg-[#e2dfd6]"></span>
    <span class="size-2 rounded-full bg-[#e2dfd6]"></span>
    <span
      class="mx-auto max-w-[70%] truncate rounded-md bg-paper px-3 py-0.5 font-mono text-[0.6875rem] leading-4 text-muted"
      >{url}</span
    >
    <span class="w-[1.875rem]"></span>
  </div>
  <Picture
    src={src}
    alt={alt}
    widths={[480, 720, 960, 1280, 1600].filter((w) => w <= src.width)}
    sizes={sizes}
    formats={["avif"]}
    fallbackFormat="webp"
    loading={eager || priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class="block aspect-[16/10] h-auto w-full object-cover object-top"
  />
</div>
