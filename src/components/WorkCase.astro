---
// Кейс целиком — на своей странице (pages/works/[id].astro): слева окно сайта
// с телефоном, справа история. Название и отрасль — в шапке страницы.
import LiveWindow from "./LiveWindow.astro";
import Icon from "./Icon.astro";
import TechIcon from "./TechIcon.astro";
import MetricValue from "./MetricValue.astro";
import MetricCard from "./MetricCard.astro";
import type { Work } from "../data/works";
import { typo } from "../lib/typo";

interface Props {
  work: Work;
  /** id заголовка страницы — подпись статьи для скринридера. */
  labelledby: string;
}

const { work, labelledby } = Astro.props;
const phone = work.screens.mobile;
// Карточки цифр идут по две в ряд, «было/стало» — во всю ширину. Если
// обычных нечётное число, последняя тоже растягивается, чтобы не стоять одна.
const plain = work.metrics.filter((metric) => metric.visual?.type !== "bars");
const lone = plain.length % 2 === 1 ? plain.at(-1) : undefined;
---

<article aria-labelledby={labelledby} class="container-page grid gap-10 pt-8 pb-20 sm:pb-28 lg:grid-cols-12 lg:items-start lg:gap-14 lg:pt-12" data-case>
  {/* Текст кейса выше окна, поэтому на широком экране окно едет рядом с ним
      при прокрутке, а не висит посередине с пустотой сверху. Окно и телефон —
      одна группа: пауза в строке адреса останавливает обоих. Окно помечено
      data-vt: в него перетекает окно из превью на главной. Окно поднято
      на нижнюю полосу обложки (CaseCover.astro) и стоит на её краю. */}
  <div class="relative -mt-20 sm:-mt-24 lg:sticky lg:top-28 lg:col-span-7 lg:-mt-44" data-live-group data-tilt="5">
    <div class:list={["relative", phone && "pr-[9%] pb-8 sm:pb-10"]} data-tilt-target>
      <div id="case-window" data-case-visual data-vt={work.id}>
        <LiveWindow
          scenes={work.screens.desktop}
          device="desktop"
          sizes="(min-width: 1280px) 40rem, (min-width: 1024px) 52vw, 92vw"
          label={`Сайт ${work.urlLabel} листается сам${work.screens.desktop.length > 1 ? ", по нескольким страницам" : ""}`}
          href={work.url}
          toggle={work.urlLabel}
          priority
          delay={0.3}
        />
      </div>
      {
        phone && (
          <div class="absolute right-0 bottom-0 w-[24%]" data-depth="18">
            <div data-case-phone>
              <LiveWindow
                scenes={[phone]}
                device="mobile"
                sizes="(min-width: 1024px) 10rem, 24vw"
                label={`Мобильная версия ${work.urlLabel} листается сама`}
                href={work.url}
                eager
                delay={1.3}
              />
            </div>
          </div>
        )
      }
    </div>
  </div>

  <div class="lg:col-span-5">
    {
      work.now && (
        <p class="inline-flex rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-ink" data-fade set:html={typo(work.now)} />
      )
    }

    {/* Кейс читается как история: задача — результат — что сделано — цифры.
        Результат для бизнеса — сразу под задачей, крупно: ради него сайт и
        делали. */}
    <h2 class:list={["case-label", !work.now && "case-label-first"]} data-fade>Задача</h2>
    <p class="mt-2 leading-relaxed text-ink-2" data-fade set:html={typo(work.task)} />

    {
      work.result && (
        <div class="case-result on-dark" data-fade>
          <h2 class="case-label case-label-dark">Результат</h2>
          <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-4">
            {work.result.figures.map((figure) => (
              <div class="flex flex-col gap-1.5">
                <dt class="order-2 text-sm leading-snug text-muted-dark" set:html={typo(figure.label)} />
                <dd class="order-1 font-mono text-[2rem] leading-none font-semibold tracking-tight whitespace-nowrap text-accent sm:text-[2.5rem]">
                  <MetricValue value={figure.value} />
                </dd>
              </div>
            ))}
          </dl>
          <p class="mt-4 border-t border-line-dark pt-4 text-[0.9375rem] leading-relaxed text-paper/85" set:html={typo(work.result.text)} />
        </div>
      )
    }

    <h2 class="case-label" data-fade>Что сделал</h2>
    <ul class="mt-3 space-y-3" data-stagger>
      {
        work.done.map((item) => (
          <li class="flex gap-3 leading-snug">
            <span class="mt-0.5" data-draw>
              <Icon name="check" class="size-[1.125rem] text-ok-text" />
            </span>
            <span set:html={typo(item)} />
          </li>
        ))
      }
    </ul>

    <h2 class="case-label" data-fade>В цифрах</h2>
    <dl class="case-metrics mt-3" data-stagger>
      {work.metrics.map((metric) => <MetricCard metric={metric} wide={metric === lone} />)}
    </dl>

    <h2 class="case-label" data-fade>На чём сделан</h2>
    <ul class="mt-3 flex flex-wrap gap-1.5" data-stagger>
      {
        work.stack.map((tech) => (
          <li class="chip flex items-center gap-1.5 rounded-md border border-line bg-surface px-2 py-1 font-mono text-xs text-ink-2">
            <TechIcon name={tech} />
            {tech}
          </li>
        ))
      }
    </ul>

    <a
      href={work.url}
      target="_blank"
      rel="noopener noreferrer"
      class="group mt-8 inline-flex min-h-11 flex-wrap items-center gap-x-2 font-semibold"
      data-fade
    >
      <span class="link-line">{work.status.tone === "concept" ? "Открыть концепт" : "Открыть сайт"}</span>
      <span class="font-mono text-sm font-normal break-all text-muted">{work.urlLabel}</span>
      <Icon name="arrow-up-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" />
      <span class="sr-only">(откроется в новой вкладке)</span>
    </a>
  </div>
</article>
