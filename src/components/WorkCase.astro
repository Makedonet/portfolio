---
import BrowserFrame from "./BrowserFrame.astro";
import PhoneFrame from "./PhoneFrame.astro";
import Icon from "./Icon.astro";
import MetricValue from "./MetricValue.astro";
import type { Work } from "../data/works";
import { typo } from "../lib/typo";

interface Props {
  work: Work;
  index: number;
}

const { work, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
/** Картинка справа у чётных кейсов — сетка читается «змейкой». */
const flip = index % 2 === 1;
const headingId = `work-${work.id}`;
---

<article aria-labelledby={headingId} class="grid gap-10 border-t border-line py-14 sm:py-20 lg:grid-cols-12 lg:items-start lg:gap-14">
  {/* Текст кейса выше картинки, поэтому на широком экране она едет рядом с
      ним при прокрутке, а не висит посередине с пустотой сверху. */}
  <div class:list={["relative lg:sticky lg:top-28 lg:col-span-7", flip && "lg:order-2"]} data-reveal>
    <a
      href={work.url}
      target="_blank"
      rel="noopener noreferrer"
      tabindex="-1"
      aria-hidden="true"
      class="group block pr-[9%] pb-8 sm:pb-10"
    >
      <BrowserFrame
        src={work.desktop}
        alt=""
        url={work.urlLabel}
        sizes="(min-width: 1280px) 40rem, (min-width: 1024px) 52vw, 92vw"
        class="transition-transform duration-500 ease-[var(--ease-out)] group-hover:-translate-y-1"
      />
      <PhoneFrame
        src={work.mobile}
        alt=""
        sizes="(min-width: 1024px) 10rem, 24vw"
        class="absolute right-0 bottom-0 w-[24%] transition-transform duration-500 ease-[var(--ease-out)] group-hover:-translate-y-2"
      />
    </a>
  </div>

  <div class:list={["lg:col-span-5", flip && "lg:order-1"]} data-reveal style="--reveal-delay: 80ms">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="font-mono text-sm text-muted">{number}</span>
      <span
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium",
          work.status.tone === "live" ? "border-ok/30 bg-ok/10 text-ok-text" : "border-line bg-surface text-muted",
        ]}
      >
        {work.status.tone === "live" && <span class="size-1.5 rounded-full bg-ok" aria-hidden="true" />}
        {work.status.label}
      </span>
    </div>

    <h3 id={headingId} class="mt-4 text-3xl leading-tight font-bold tracking-[-0.025em] text-balance sm:text-[2.125rem]">
      {work.title}
    </h3>
    <p class="mt-1.5 text-muted" set:html={typo(work.kind)} />

    {work.now && <p class="mt-4 inline-flex rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-ink" set:html={typo(work.now)} />}

    <p class="mt-5 leading-relaxed text-ink-2" set:html={typo(work.summary)} />

    <ul class="mt-6 space-y-3" aria-label="Что сделано">
      {
        work.done.map((item) => (
          <li class="flex gap-3 leading-snug">
            <Icon name="check" class="mt-0.5 size-[1.125rem] text-ok-text" />
            <span set:html={typo(item)} />
          </li>
        ))
      }
    </ul>

    <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6 sm:grid-cols-3">
      {
        work.metrics.map((metric) => (
          <div class="flex flex-col gap-1">
            <dt class="order-2 text-[0.8125rem] leading-snug text-muted" set:html={typo(metric.label)} />
            <dd class="order-1 font-mono text-xl font-semibold tracking-tight whitespace-nowrap">
              <MetricValue value={metric.value} />
            </dd>
          </div>
        ))
      }
    </dl>

    <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Технологии">
      {
        work.stack.map((tech) => (
          <li class="rounded-md border border-line bg-surface px-2 py-1 font-mono text-xs text-ink-2">{tech}</li>
        ))
      }
    </ul>

    <a
      href={work.url}
      target="_blank"
      rel="noopener noreferrer"
      class="group mt-8 inline-flex min-h-11 flex-wrap items-center gap-x-2 font-semibold underline decoration-ink/25 decoration-2 underline-offset-[6px] transition-colors hover:decoration-ink"
    >
      {work.status.tone === "concept" ? "Открыть концепт" : "Открыть сайт"}
      <span class="font-mono text-sm font-normal break-all text-muted">{work.urlLabel}</span>
      <Icon
        name="arrow-up-right"
        class="size-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      />
      <span class="sr-only">(откроется в новой вкладке)</span>
    </a>
  </div>
</article>
