---
import LiveWindow from "./LiveWindow.astro";
import Icon from "./Icon.astro";
import MetricValue from "./MetricValue.astro";
import type { Work } from "../data/works";
import { typo } from "../lib/typo";

interface Props {
  work: Work;
  index: number;
}

const { work, index } = Astro.props;
/** Окно справа у чётных кейсов — сетка читается «змейкой». */
const flip = index % 2 === 1;
const headingId = `work-${work.id}`;
const phone = work.screens.mobile;
---

<article aria-labelledby={headingId} class="grid gap-10 border-t border-line py-14 sm:py-20 lg:grid-cols-12 lg:items-start lg:gap-14" data-case>
  {/* Текст кейса выше окна, поэтому на широком экране окно едет рядом с ним
      при прокрутке, а не висит посередине с пустотой сверху. Окно и телефон —
      одна группа: пауза в строке адреса останавливает обоих. */}
  <div
    class:list={["relative lg:sticky lg:top-28 lg:col-span-7", flip && "lg:order-2"]}
    data-live-group
    data-tilt="5"
  >
    <div class:list={["relative", phone && "pr-[9%] pb-8 sm:pb-10"]} data-tilt-target>
      <div data-case-visual>
        <LiveWindow
          scenes={work.screens.desktop}
          device="desktop"
          sizes="(min-width: 1280px) 40rem, (min-width: 1024px) 52vw, 92vw"
          label={`Сайт ${work.urlLabel} листается сам${work.screens.desktop.length > 1 ? ", по нескольким страницам" : ""}`}
          href={work.url}
          toggle={work.urlLabel}
          delay={0.3}
        />
      </div>
      {
        phone && (
          <div class="absolute right-0 bottom-0 w-[24%]" data-depth="18">
            <div data-case-phone>
              <LiveWindow
                scenes={[phone]}
                device="mobile"
                sizes="(min-width: 1024px) 10rem, 24vw"
                label={`Мобильная версия ${work.urlLabel} листается сама`}
                href={work.url}
                delay={1.3}
              />
            </div>
          </div>
        )
      }
    </div>
  </div>

  <div class:list={["lg:col-span-5", flip && "lg:order-1"]}>
    <h3
      id={headingId}
      class="text-3xl leading-tight font-bold tracking-[-0.025em] text-balance sm:text-[2.125rem]"
      data-split
      set:html={typo(work.title)}
    />
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2" data-fade>
      <p class="text-muted" set:html={typo(work.kind)} />
      <span
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium",
          work.status.tone === "live" ? "border-ok/30 bg-ok/10 text-ok-text" : "border-line bg-surface text-muted",
        ]}
      >
        {work.status.tone === "live" && <span class="size-1.5 animate-pulse rounded-full bg-ok motion-reduce:animate-none" aria-hidden="true" />}
        {work.status.label}
      </span>
    </div>

    {
      work.now && (
        <p class="mt-4 inline-flex rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-ink" data-fade set:html={typo(work.now)} />
      )
    }

    <p class="mt-5 leading-relaxed text-ink-2" data-fade set:html={typo(work.summary)} />

    <ul class="mt-6 space-y-3" aria-label="Что сделано" data-stagger>
      {
        work.done.map((item) => (
          <li class="flex gap-3 leading-snug">
            <span class="mt-0.5" data-draw>
              <Icon name="check" class="size-[1.125rem] text-ok-text" />
            </span>
            <span set:html={typo(item)} />
          </li>
        ))
      }
    </ul>

    <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6 sm:grid-cols-3" data-stagger>
      {
        work.metrics.map((metric) => (
          <div class="flex flex-col gap-1">
            <dt class="order-2 text-[0.8125rem] leading-snug text-muted" set:html={typo(metric.label)} />
            <dd class="order-1 font-mono text-xl font-semibold tracking-tight whitespace-nowrap">
              <MetricValue value={metric.value} />
            </dd>
          </div>
        ))
      }
    </dl>

    <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Технологии" data-stagger>
      {work.stack.map((tech) => <li class="chip rounded-md border border-line bg-surface px-2 py-1 font-mono text-xs text-ink-2">{tech}</li>)}
    </ul>

    <a
      href={work.url}
      target="_blank"
      rel="noopener noreferrer"
      class="group mt-8 inline-flex min-h-11 flex-wrap items-center gap-x-2 font-semibold"
      data-fade
    >
      <span class="link-line">{work.status.tone === "concept" ? "Открыть концепт" : "Открыть сайт"}</span>
      <span class="font-mono text-sm font-normal break-all text-muted">{work.urlLabel}</span>
      <Icon name="arrow-up-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" />
      <span class="sr-only">(откроется в новой вкладке)</span>
    </a>
  </div>
</article>
