---
// Знак — ключ: «сайты под ключ». Головка — жёлтая плашка с «М», лезвие
// цвета текста (currentColor), поэтому знак работает и на светлом, и на
// тёмном фоне. Фавиконка (public/favicon.svg) — тот же ключ на чёрной плашке.
// При наведении на ссылку с классом group ключ «поворачивается в замке»
// (global.css, .logo-key).
interface Props {
  class?: string;
}
const { class: className = "h-6 w-auto" } = Astro.props;
---

<svg viewBox="0 0 41 24" class:list={["logo-key", className]} aria-hidden="true" focusable="false">
  <rect width="24" height="24" rx="7" fill="var(--color-accent)"></rect>
  <path
    d="M6 18V6.5l6 7 6-7V18"
    fill="none"
    stroke="var(--color-ink)"
    stroke-width="3.4"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path
    d="M24 9.5h15a1.8 1.8 0 0 1 1.8 1.8v1.4a1.8 1.8 0 0 1-1.8 1.8h-1.3v3.3a1 1 0 0 1-1 1h-1.9a1 1 0 0 1-1-1v-3.3h-1.6v1.9a1 1 0 0 1-1 1h-1.9a1 1 0 0 1-1-1v-1.9H24z"
    fill="currentColor"></path>
</svg>
