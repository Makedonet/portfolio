---
// Знак: «М» и жёлтая черта под ней — курсор в строке, сайт в работе.
// Тот же рисунок лежит в public/favicon.svg.
interface Props {
  class?: string;
}
const { class: className = "size-10" } = Astro.props;
---

<svg viewBox="0 0 40 40" class={className} aria-hidden="true" focusable="false">
  <rect width="40" height="40" rx="10" fill="var(--color-ink)"></rect>
  <path
    d="M11 26.5V11.5l9 9.5 9-9.5v15"
    fill="none"
    stroke="var(--color-paper)"
    stroke-width="3.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <rect x="11" y="30" width="18" height="3.4" rx="1.7" fill="var(--color-accent)"></rect>
</svg>
