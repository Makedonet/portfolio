---
// «Живое окно»: сайт в рамке браузера или телефона сам листается, как запись
// экрана. Сразу видна картинка первого экрана (постер) — она же остаётся без
// скрипта и при «уменьшить движение». Длинный кадр страницы скрипт
// (scripts/live.ts) подгружает, когда окно подходит к экрану, и прокручивает
// его GSAP-таймлайном с паузами на секциях. Несколько кадров в одном окне —
// переход по страницам сайта: адрес в строке меняется вместе с кадром.
import type { ImageMetadata } from "astro";
import { Picture, getImage } from "astro:assets";
import { scene as loadScene, viewportHeight } from "../data/live";

interface Props {
  scenes: string[];
  device: "desktop" | "mobile";
  /** Ширина окна на странице — по ней браузер выбирает размер кадров. */
  sizes: string;
  /** Подпись для скринридера: что показано в окне. */
  label: string;
  /** Окно на первом экране: постер грузить сразу. */
  eager?: boolean;
  /** Главная картинка первого экрана (LCP). */
  priority?: boolean;
  /** Куда ведёт клик по экрану окна: сам сайт (в новой вкладке) или страница
   *  кейса. */
  href?: string;
  /** Кнопка паузы в строке адреса: останавливает все окна группы. Значение —
   *  чьи окна (для подписи кнопки): кнопок на странице несколько, и у каждой
   *  должна быть своя подпись. */
  toggle?: string;
  /** Сдвиг старта, с, — чтобы соседние окна не листались синхронно. */
  delay?: number;
  class?: string;
}

const { scenes: ids, device, sizes, label, eager = false, priority = false, href, toggle, delay = 0, class: className } = Astro.props;
const desktop = device === "desktop";
const external = /^https?:/.test(href ?? "");
const scenes = ids.map(loadScene);
const first = scenes[0]!;
const screenHeight = viewportHeight(device);

const widthsFor = (image: ImageMetadata, list: number[]) => list.filter((w) => w <= image.width);

/** Если страниц в окне несколько, на каждой не больше пяти остановок — иначе
 *  до второй страницы «видео» добиралось бы полминуты. Берутся равномерно. */
const thin = (stops: number[]) => {
  const limit = ids.length > 1 ? 5 : Infinity;
  if (stops.length <= limit) return stops;
  return Array.from({ length: limit }, (_, i) => stops[Math.round(((i + 1) * stops.length) / limit) - 1]!);
};
const pageWidths = desktop ? [640, 960, 1280] : [270, 360, 540, 780];

const prepared = await Promise.all(
  scenes.map(async (scene) => {
    const widths = widthsFor(scene.page, pageWidths);
    const avif = await getImage({ src: scene.page, widths, format: "avif", quality: 50 });
    const webp = await getImage({ src: scene.page, widths, format: "webp", quality: 68 });
    const header = scene.headerImage
      ? await getImage({ src: scene.headerImage, widths: widthsFor(scene.headerImage, pageWidths), format: "webp", quality: 80 })
      : undefined;
    return {
      scene,
      avif: avif.srcSet.attribute,
      webp: webp.srcSet.attribute,
      webpSrc: webp.src,
      header,
      // Остановки — в процентах высоты кадра: так они не зависят от ширины окна.
      stops: thin(scene.stops).map((px) => Number(((px / scene.height) * 100).toFixed(3))),
      // Дальше этого кадр не уезжает: низ кадра совпадает с низом экрана.
      max: Number((((scene.height - screenHeight) / scene.height) * 100).toFixed(3)),
      screens: Number((scene.height / screenHeight).toFixed(3)),
    };
  }),
);
---

<div
  class:list={[
    "live relative isolate",
    desktop
      ? "overflow-hidden rounded-xl bg-surface shadow-[0_1px_2px_rgb(17_17_16/0.06),0_14px_36px_-10px_rgb(17_17_16/0.22)] ring-1 ring-ink/10"
      : "overflow-hidden rounded-[1.4rem] border-[5px] border-ink bg-ink shadow-[0_18px_40px_-12px_rgb(17_17_16/0.45)] sm:rounded-[1.75rem] sm:border-[6px]",
    className,
  ]}
  data-live
  data-delay={delay}
>
  {
    desktop && (
      <div class="flex h-7 items-center gap-1.5 border-b border-line bg-[#f8f7f3] px-3 sm:h-8">
        <span class="size-2 rounded-full bg-[#e2dfd6]" aria-hidden="true" />
        <span class="size-2 rounded-full bg-[#e2dfd6]" aria-hidden="true" />
        <span class="size-2 rounded-full bg-[#e2dfd6]" aria-hidden="true" />
        <span
          class="relative mx-auto max-w-[70%] overflow-hidden rounded-md bg-paper px-3 py-0.5 font-mono text-xs leading-4 text-muted"
          aria-hidden="true"
        >
          <span class="block truncate" data-live-url>
            {first.url}
          </span>
          <span class="absolute inset-x-0 bottom-0 h-[2px] origin-left scale-x-0 bg-ink/35" data-live-progress />
        </span>
        {toggle ? (
          <button
            type="button"
            class="live-toggle -mr-1.5 h-7 w-8 place-items-center rounded-md text-muted transition-colors hover:bg-ink/5 hover:text-ink sm:h-8"
            data-live-toggle
            data-label-pause={`Остановить прокрутку: ${toggle}`}
            data-label-play={`Запустить прокрутку: ${toggle}`}
            aria-label={`Остановить прокрутку: ${toggle}`}
          >
            <svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor" aria-hidden="true">
              <path class="live-toggle-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
              <path class="live-toggle-play hidden" d="M8 5.5v13l10.5-6.5z" />
            </svg>
          </button>
        ) : (
          <span class="w-[1.875rem]" aria-hidden="true" />
        )}
      </div>
    )
  }

  <div
    class:list={[
      "relative overflow-hidden",
      desktop ? "aspect-[16/10] bg-ink" : "aspect-[390/844] rounded-[1rem] bg-ink sm:rounded-[1.3rem]",
    ]}
    data-live-screen
    data-cursor="Колёсико — листать сайт"
  >
    <div class="absolute inset-0" role="img" aria-label={label}>
    <Picture
      src={first.poster}
      alt=""
      widths={widthsFor(first.poster, pageWidths)}
      sizes={sizes}
      formats={["avif"]}
      fallbackFormat="webp"
      loading={eager || priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-top"
    />
    {
      prepared.map((item, i) => (
        <div
          class="absolute inset-0"
          style={i > 0 ? "opacity: 0; visibility: hidden" : undefined}
          data-live-scene
          data-url={item.scene.url}
          data-stops={JSON.stringify(item.stops)}
          data-max={item.max}
          data-screens={item.screens}
        >
          <picture>
            <source type="image/avif" data-srcset={item.avif} sizes={sizes} />
            <img
              class="absolute top-0 left-0 h-auto w-full opacity-0 will-change-transform"
              data-live-page
              data-srcset={item.webp}
              data-src={item.webpSrc}
              sizes={sizes}
              width={item.scene.page.width}
              height={item.scene.page.height}
              alt=""
              decoding="async"
            />
          </picture>
          {item.header && (
            <img
              class="absolute top-0 left-0 h-auto w-full opacity-0"
              data-live-header
              data-srcset={item.header.srcSet.attribute}
              data-src={item.header.src}
              sizes={sizes}
              width={item.scene.headerImage!.width}
              height={item.scene.headerImage!.height}
              alt=""
              decoding="async"
            />
          )}
        </div>
      ))
    }
    </div>
    {href && <a href={href} {...(external && { target: "_blank", rel: "noopener noreferrer" })} tabindex="-1" aria-hidden="true" class="absolute inset-0 z-10" />}
  </div>
</div>
